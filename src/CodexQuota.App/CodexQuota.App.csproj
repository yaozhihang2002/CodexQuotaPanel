    <ProjectReference Include="../CodexQuota.Application/CodexQuota.Application.csproj" />
    <ProjectReference Include="../CodexQuota.Infrastructure/CodexQuota.Infrastructure.csproj" />
    <ProjectReference Include="../CodexQuota.Platform.Windows/CodexQuota.Platform.Windows.csproj" />
    <ProjectReference Include="../CodexQuota.Platform.macOS/CodexQuota.Platform.macOS.csproj" />
    <ProjectReference Include="../CodexQuota.UI.Avalonia/CodexQuota.UI.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
