<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.6.1</Version>
    <AssemblyVersion>0.6.1.0</AssemblyVersion>
    <FileVersion>0.6.1.0</FileVersion>
    <InformationalVersion>0.6.1</InformationalVersion>
    <AssemblyName>CodexQuotaPanel</AssemblyName>
    <RootNamespace>CodexQuota.App</RootNamespace>
    <ApplicationIcon>Assets\CodexQuotaPanel.ico</ApplicationIcon>
